<?xml version="1.0" encoding="utf-8"?>
<!-- La agenda plegada: una sola línea con lo siguiente que toca.
     El fondo oscuro va dentro del propio diseño porque MIUI pinta el de la
     notificación según su tema; con el tema claro, el neón sobre blanco no
     se leería. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/fondo_notif"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">

    <TextView
        android:id="@+id/np_cuando"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:textColor="#00E5FF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/np_titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="#E8ECF5"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/np_mas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="#7C869C"
        android:textSize="12sp" />
</LinearLayout>
