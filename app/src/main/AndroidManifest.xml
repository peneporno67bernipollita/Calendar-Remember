<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Avisos y alarmas. USE_EXACT_ALARM se concede solo a las apps cuya
         razón de ser es avisar a una hora concreta, que es exactamente el
         caso: sin alarma exacta, un recordatorio no sirve para nada. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Para volver a programar los avisos cuando se reinicia el móvil. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Escuchar "Nébula". El servicio en primer plano es lo que Android
         exige para usar el micrófono con la app cerrada. Con la pantalla
         apagada solo escucha si se activa en los ajustes. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Sin esto, Android no deja que el servicio abra el dictado al oír la
         palabra: un servicio no puede abrir pantallas por su cuenta. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Para pedir que el ahorro de batería no mate la escucha. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- El dictado se lo pedimos al reconocedor del sistema. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Tema.Nebula">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/atajos" />
        </activity>

        <!-- Dictar de un toque. Se expone como acceso directo y como acción
             de voz para poder lanzarla desde el asistente. -->
        <activity
            android:name=".voz.VozActivity"
            android:exported="true"
            android:label="@string/atajo_dictar_largo"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:showWhenLocked="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- El gesto de asistente (mantener pulsado el boton de encendido
                 o deslizar desde la esquina) puede apuntar aqui. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- La pantalla de la alarma: sale encima del bloqueo. -->
        <activity
            android:name=".avisos.AlarmaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Escucha "Nébula" con la pantalla encendida. -->
        <service
            android:name=".voz.EscuchaServicio"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Boton de dictado en la persiana de ajustes rapidos. -->
        <service
            android:name=".voz.TileVoz"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/atajo_dictar"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lee los mensajes de WhatsApp que llegan para ofrecer apuntar los
             planes. Solo si el usuario le da acceso a las notificaciones. -->
        <service
            android:name=".avisos.OyenteWhatsApp"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".avisos.ReceptorAviso"
            android:exported="true">
            <intent-filter>
                <action android:name="com.calendarremember.AVISO" />
                <action android:name="com.calendarremember.MANTENIMIENTO" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.WidgetProximos"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
