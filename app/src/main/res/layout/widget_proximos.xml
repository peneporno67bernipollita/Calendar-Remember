<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de pantalla de inicio: lo que viene y el botón de dictar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/fondo_widget"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_titulo"
            android:textColor="#00E5FF"
            android:textSize="11sp"
            android:letterSpacing="0.18"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/boton_voz"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="7dp"
            android:background="@drawable/fondo_boton_voz"
            android:src="@drawable/ic_mic"
            android:contentDescription="@string/widget_dictar" />
    </LinearLayout>

    <TextView
        android:id="@+id/vacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_vacio"
        android:textColor="#7C869C"
        android:textSize="13sp"
        android:paddingTop="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fila_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="3dp">
        <TextView
            android:id="@+id/cuando_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="74dp"
            android:textColor="#00E5FF"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/titulo_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8ECF5"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="3dp">
        <TextView
            android:id="@+id/cuando_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="74dp"
            android:textColor="#00E5FF"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/titulo_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8ECF5"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/fila_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="3dp">
        <TextView
            android:id="@+id/cuando_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="74dp"
            android:textColor="#00E5FF"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/titulo_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8ECF5"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
